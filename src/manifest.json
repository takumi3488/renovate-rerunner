{
	"$schema": "https://json.schemastore.org/chrome-manifest.json",
	"chromium:manifest_version": 3,
	"firefox:manifest_version": 2,
	"version": "1.0.0",
	"firefox:browser_specific_settings": {
		"gecko": {
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"name": "renovate-rerunner",
	"description": "developer.mend.io で Renovate が disabled のリポジトリに Run Renovate scan を一括実行します。",
	"icons": {
		"16": "images/icon.png",
		"32": "images/icon.png",
		"48": "images/icon.png",
		"64": "images/icon.png",
		"128": "images/icon.png"
	},
	"chromium:action": {
		"default_icon": {
			"16": "images/icon.png",
			"32": "images/icon.png",
			"48": "images/icon.png",
			"64": "images/icon.png",
			"128": "images/icon.png"
		},
		"default_title": "renovate-rerunner 設定"
	},
	"firefox:browser_action": {
		"default_icon": {
			"16": "images/icon.png",
			"32": "images/icon.png",
			"48": "images/icon.png",
			"64": "images/icon.png",
			"128": "images/icon.png"
		},
		"default_title": "renovate-rerunner 設定"
	},
	"chromium:side_panel": {
		"default_path": "sidebar/index.html",
		"default_title": "renovate-rerunner 設定"
	},
	"firefox:sidebar_action": {
		"default_panel": "sidebar/index.html",
		"default_title": "renovate-rerunner 設定"
	},
	"chromium:permissions": ["sidePanel", "storage"],
	"chromium:host_permissions": ["https://api.github.com/*"],
	"firefox:permissions": ["storage", "https://api.github.com/*"],
	"background": {
		"chromium:service_worker": "background.js",
		"firefox:scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://developer.mend.io/*"],
			"js": ["content/scripts.js"]
		}
	]
}
